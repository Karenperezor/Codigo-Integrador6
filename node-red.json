    {
        "id": "5fda8b4ea4c9826b",
        "type": "function",
        "z": "bf3766469e0bad75",
        "name": "Procesar Datos",
        "func": "var d = msg.payload;\n\n// 1. Asegurar que los datos sean números para InfluxDB\nvar bpm_num = parseInt(d.bpm || d.BPM || 0);\n// Agregamos más variantes comunes para el nombre del sensor\nvar spo2_num = parseInt(d.spo2 || d.SPO2 || d.SpO2 || d.oxigeno || 0);\n//var spo2_num = parseInt(d.spo2 || d.SPO2 || 0); // <-- Nueva variable para Oxígeno\nvar acel_num = parseFloat(d.acel || d.AccX || 0);\nvar lat_num = parseFloat(d.lat || d.Lat || 0);\nvar lon_num = parseFloat(d.lon || d.Lon || 0);\n\n// 2. Mantener variables originales para tu Dashboard\nd.ax = d.AccX || 0;\nd.ay = d.AccY || 0;\nd.az = d.AccZ || 0;\nd.bpm = bpm_num;\nd.spo2 = spo2_num; // <-- Aseguramos que el Dashboard también lo tenga\nd.acel = acel_num;\nd.latitud = lat_num;\nd.longitud = lon_num;\nd.hora = new Date().toLocaleTimeString();\n\n// 3. Lógica de alertas\nif (d.SOS === 1 || d.tipo === \"PANICO\" || acel_num > 2.5) {\n    d.estadoSistema = 'PANICO';\n    d.eventoMovimiento = (acel_num > 2.5) ? 'CAIDA/FORCEJEO' : 'BOTON PANICO';\n} else {\n    d.estadoSistema = 'NORMAL';\n    d.eventoMovimiento = 'REPOSO';\n}\n\n// 4. Formatos de salida\nvar msgDashboard = { payload: d };\n\nvar msgInflux = {\n    payload: {\n        bpm: bpm_num,\n        spo2: spo2_num, // <-- Se añade al objeto para InfluxDB\n        acel: acel_num,\n        lat: lat_num,\n        lon: lon_num\n    }\n};\n\nreturn [msgDashboard, msgInflux];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 380,
        "wires": [
            [
                "94f25aa8c3194079"
            ],
            [
                "191851c1b45e0105"
            ]
        ]
    },
    {
        "id": "94f25aa8c3194079",
        "type": "function",
        "z": "bf3766469e0bad75",
        "name": "Separar Salidas",
        "func": "var d = msg.payload;\nvar msg1  = {payload: d.latitud};\nvar msg2  = {payload: d.longitud};\nvar msg3  = {payload: d.bpm};\nvar msg4  = {payload: d.estadoBPM};\nvar msg5  = {payload: d.ax, topic: 'Eje X'};\nvar msg6  = {payload: d.ay, topic: 'Eje Y'};\nvar msg7  = {payload: d.az, topic: 'Eje Z'};\nvar msg8  = {payload: d.acel};\nvar msg9  = {payload: d.estadoSistema + ' | ' + d.tipoMovimiento};\nvar msg10 = {payload: d.eventoMovimiento};\nvar msg11 = {payload: d.hora};\nvar msg12 = {payload: d.spo2};\nvar msg13 = {\n    payload: {\n        name: 'Julieta',\n        lat: d.latitud,\n        lon: d.longitud,\n        icon: d.estadoSistema === 'PANICO' ? 'fa-exclamation-triangle' : 'fa-user',\n        iconColor: d.estadoSistema === 'PANICO' ? 'red' : 'green',\n        label: 'Julieta',\n        popup: '<b>Julieta</b><br>Estado: ' + d.estadoSistema + '<br>BPM: ' + d.bpm + '<br>Acel: ' + d.acel + 'g<br>' + d.hora\n    }\n};\n\n\n\n\n// Reordenado para coincidir con tus nodos físicos en orden descendente\nreturn [msg1, msg2, msg3, msg4, msg5, msg6, msg7, msg8, msg9, msg10, msg11, msg12, msg13];",
        "outputs": 13,
        "timeout": "",
