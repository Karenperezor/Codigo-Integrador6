    {
        "id": "wa_armar_mensaje",
        "type": "function",
        "z": "bf3766469e0bad75",
        "name": "Armar Mensaje WhatsApp",
        "func": "var d = msg.payload;\n\nif (typeof d === 'string') {\n    try { d = JSON.parse(d); } catch(e) { d = {}; }\n}\n\nvar bpm = d.bpm || d.BPM || '--';\nvar lat = d.lat || d.Lat || '--';\nvar lon = d.lon || d.Lon || '--';\nvar hora = new Date().toLocaleTimeString('es-MX');\n\nvar estadoBpm = '';\nif (bpm !== '--') {\n    if (bpm > 140) estadoBpm = ' (muy elevado, posible pánico o esfuerzo extremo)';\n    else if (bpm > 100) estadoBpm = ' (elevado)';\n    else estadoBpm = ' (normal)';\n}\n\nvar ubicacion = (lat !== '--' && lon !== '--')\n    ? 'https://maps.google.com/?q=' + lat + ',' + lon\n    : 'No disponible aún';\n\nvar texto = '🚨 ALERTA DE EMERGENCIA 🚨\\n\\n';\ntexto += '⚠️ La pulsera de Julieta se acaba de activar.\\n';\ntexto += 'Esto significa que puede estar en peligro.\\n\\n';\ntexto += '🕐 Hora: ' + hora + '\\n';\nif (bpm !== '--') texto += '❤️ Ritmo cardiaco: ' + bpm + ' latidos/min' + estadoBpm + '\\n';\ntexto += '📍 Última ubicación conocida:\\n' + ubicacion + '\\n\\n';\ntexto += 'Por favor comunícate con ella o llama al 911.';\n\n\n\nvar apikey  = '3414452';\nvar baseUrl = 'https://api.callmebot.com/whatsapp.php?text=' + encodeURIComponent(texto);\n\n// ── Agrega o quita contactos aquí ──────────────────────────────\nvar contactos = [\n    { telefono: '5217721415937', apikey: '3414452' }, // Contacto 1 (original)\n    { telefono: '521771XXXXXXX', apikey: 'XXXXXX'  }, // Contacto 2\n    { telefono: '521771YYYYYYY', apikey: 'YYYYYY'  }, // Contacto 3\n];\n// ───────────────────────────────────────────────────────────────\n\nvar mensajes = contactos.map(function(c) {\n    return {\n        url:    baseUrl + '&phone=' + c.telefono + '&apikey=' + c.apikey,\n        method: 'GET',\n        payload: msg.payload\n    };\n});\n\nreturn mensajes; // Node-RED envía uno por salida",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 870,
        "y": 820,
